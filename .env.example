# Azure Cosmos DB for NoSQL. Uses AAD auth via DefaultAzureCredential.
# If the account has local auth (keys) disabled, no key is needed here; sign in with `az login`.
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_DATABASE=docs
COSMOS_CONTAINER=pages

# Document set / virtual FS
# Namespace is the scope (partition key value). Optional: unset => whole container.
COSMOS_FS_NAMESPACE=<your-namespace>

# Field mapping (optional): explore an existing container whose fields differ from
# the canonical content/key/namespace. Flags --content-field/--key-field/--namespace-field
# override these. Paths may be nested, e.g. metadata.source.
# COSMOS_FS_CONTENT_FIELD=content
# COSMOS_FS_KEY_FIELD=key
# COSMOS_FS_NAMESPACE_FIELD=namespace

# Ingest only: local folder to upload. Any data works, such as docs, code, or notes.
# Not needed to explore an existing container. The bundled sample documents are a runnable default.
CORPUS_ROOT=./examples/sample-docs
